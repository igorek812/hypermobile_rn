{
  "expo": {
    "name": "hypermobile",
    "slug": "hypermobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_hypermobile_rn.png",
    "scheme": "hypermobilern",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.btc.hypermobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "X9ARV8DQ77"
    },
    "android": {
      "googleServicesFile": "./assets/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#08453D",
        "foregroundImage": "./assets/images/app_icon_hypermobile_rn.png",
        "monochromeImage": "./assets/images/app_icon_hypermobile_rn.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.btc.hypermobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_icon_hypermobile_rn.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#08453D",
          "dark": {
            "backgroundColor": "#08453D"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for scan QR code",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-system-ui"
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "hyperliquid-mobile-rn"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40af89ac-c413-4484-8182-766c0950ecb8"
      }
    },
    "owner": "hypermobile_rn"
  }
}
